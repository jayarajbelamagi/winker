{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://winker-4.onrender.com/api/:path*"
    },
    {
      "source": "/ping",
      "destination": "https://winker-4.onrender.com/ping"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
